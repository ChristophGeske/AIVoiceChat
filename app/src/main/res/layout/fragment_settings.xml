<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true"
    android:padding="12dp"
    tools:context=".feature.settings.ui.SettingsFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1C20"
        app:cardCornerRadius="12dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:id="@+id/settingsRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:paddingBottom="100dp">

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- API KEYS SECTION -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🔑 API Keys"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/apiKeysGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/gemini_api_key_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/geminiApiKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/geminiApiKeyHelpLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:linksClickable="true"
                    android:textColor="#64B5F6"
                    android:visibility="gone"
                    tools:text="Get free Gemini API Key here" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/openai_api_key_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/openaiApiKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2D32" />

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- MODEL SELECTION SECTION -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🤖 AI Model"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Select the model that will understand your voice and generate responses."
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/modelsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <!-- Gemini row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioGeminiFlash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gemini_flash"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/radioGeminiPro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/gemini_pro"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- GPT-5 Mini Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="GPT-5 Mini"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/gpt5_mini_desc"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioGpt5MiniHigh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gpt5_mini_high"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/radioGpt5MiniMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/gpt5_mini_medium"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- GPT-5.1 Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="GPT-5.1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/gpt51_desc"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioGpt51Low"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gpt51_low"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/radioGpt51Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/gpt51_medium"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/radioGpt51High"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/gpt51_high"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2D32" />

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- RESPONSE SETTINGS SECTION -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="💬 Response Settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Max sentences -->
            <LinearLayout
                android:id="@+id/maxSentencesGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/maxSentencesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/max_sentences_label"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/max_sentences_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/maxSentencesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Faster First -->
            <LinearLayout
                android:id="@+id/fasterFirstGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFasterFirst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/faster_first_label"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/fasterFirstDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/faster_first_desc"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2D32" />

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- LISTENING SETTINGS SECTION -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🎤 Listening Settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Listening time -->
            <LinearLayout
                android:id="@+id/listenSecondsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/listenSecondsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listening time (seconds)"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., 5, 10, 30">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/listenSecondsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/listenSecondsDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="How long to wait for speech before timing out."
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- AUTO-LISTEN TOGGLE -->
            <LinearLayout
                android:id="@+id/autoListenGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoListen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-listen after response"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/autoListenDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Automatically start listening again after the assistant finishes speaking."
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Audio Processing Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#252830"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Audio Processing"
                    android:textColor="#64B5F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/audioProcessingInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your voice is sent directly to the AI model. Real-time transcription shows exactly what you said, including filler words for 100% accuracy."
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#2A2D32" />

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TTS SETTINGS -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Text-to-Speech Settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ttsSettingsLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Open TTS Settings →"
                android:textColor="#64B5F6"
                android:textSize="14sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#2A2D32" />

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- PROMPT SETTINGS SECTION -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="📝 System Prompts"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Control how the AI behaves and responds."
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/systemPromptGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Base System Prompt (EDITABLE) -->
                <TextView
                    android:id="@+id/systemPromptTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏️ Base System Prompt"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="2dp"
                    android:text="Edit this to change the AI's personality and behavior."
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/system_prompt_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/systemPromptInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/system_prompt_hint"
                        android:inputType="textMultiLine"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetSystemPromptButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/reset_prompt" />

                <!-- Custom Extensions (EDITABLE) -->
                <TextView
                    android:id="@+id/promptExtensionsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="✏️ Custom Extensions (Optional)"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/promptExtensionsDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="2dp"
                    android:text="Add your own custom instructions here."
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/promptExtensionsLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Your custom instructions">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/promptExtensionsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLines="5"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetPromptExtensionsButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Clear" />

                <!-- Faster First Warning -->
                <TextView
                    android:id="@+id/systemPromptWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#33FF9800"
                    android:padding="10dp"
                    android:text="⚠️ 'Faster First Sentence' uses a two-phase strategy. Phase 1 generates first sentence quickly, Phase 2 generates the rest."
                    android:textColor="#FFB74D"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- RESPONSE INSTRUCTIONS (EDITABLE - SYNCED WITH SETTINGS) -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="🔧 Response Instructions"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="2dp"
                    android:text="Edit these directly OR use the settings above. Changes sync both ways automatically."
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dynamicInstructionsLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Response instructions (editable)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dynamicInstructionsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLines="10"
                        android:minLines="4"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1A3320"
                    android:padding="8dp"
                    android:text="💡 Tip: Change the number in 'AT MOST X sentences' to update the Max Sentences setting, or change the setting to update this text."
                    android:textColor="#81C784"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetDynamicInstructionsButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Reset to Default" />

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- FULL PROMPT PREVIEW (READ-ONLY) -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="👁️ Preview: What AI Will Receive"
                    android:textColor="#64B5F6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="2dp"
                    android:text="Read-only preview showing: Base Prompt + Extensions + Response Instructions combined."
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1A1A1A"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/fullPromptPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.2"
                        android:maxLines="20"
                        android:textColor="#A5D6A7"
                        android:textSize="11sp"
                        tools:text="You are a helpful assistant...\n\n[Custom Extensions]\n\nRESPONSE REQUIREMENTS:\n• Response MUST be AT MOST 4 sentences..." />
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>