<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- =============================================================== -->
    <!-- ASSISTANT MESSAGE LAYOUT -->
    <!-- =============================================================== -->
    <LinearLayout
        android:id="@+id/assistantMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textAssistantSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assistant"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAssistantMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp"
                tools:text="This is a sample response from the assistant." />
        </LinearLayout>

        <ImageButton
            android:id="@+id/replayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Replay message"
            android:src="@drawable/ic_speaker"
            app:tint="#CCCCCC" />

    </LinearLayout>

    <!-- =============================================================== -->
    <!-- USER MESSAGE LAYOUT -->
    <!-- =============================================================== -->
    <LinearLayout
        android:id="@+id/userMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- NEW: Transcript Status Label -->
            <TextView
                android:id="@+id/userTranscriptStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#808080"
                android:textSize="10sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="Preview Transcript"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textUserSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:textColor="#90CAF9"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_background_user"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:textColor="#E0E0E0"
            android:textIsSelectable="true"
            android:textSize="16sp"
            tools:text="This is a sample message from the user." />

    </LinearLayout>

    <!-- =============================================================== -->
    <!-- SYSTEM MESSAGE LAYOUT (Errors, Info, etc.) -->
    <!-- =============================================================== -->
    <TextView
        android:id="@+id/systemMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:background="#2A2D32"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="#9E9E9E"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="System message: Generation interrupted."
        tools:visibility="visible" />

</LinearLayout>